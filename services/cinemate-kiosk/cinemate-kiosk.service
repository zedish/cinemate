[Unit]
Description=Cinemate Web Kiosk (Wayfire)
Documentation=https://github.com/Tiramisioux/cinemate
After=seatd.service network.target cinemate-autostart.service
Wants=seatd.service cinemate-autostart.service

[Service]
User=pi
Type=simple
Restart=on-failure
RestartSec=10
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=/bin/mkdir -p /run/user/1000
ExecStartPre=/bin/chown pi:pi /run/user/1000
ExecStartPre=/usr/bin/bash -c 'for i in $$(seq 1 30); do curl -sf http://localhost:5000 >/dev/null && break; sleep 2; done'
ExecStart=/usr/bin/wayfire -c /home/pi/.config/wayfire.ini

[Install]
WantedBy=multi-user.target
